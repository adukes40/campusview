# FAKE test answers for the clean-room harness. Never use these values on a real server.
# Leave a secret blank to have install.sh generate one.
# No CV_INSTALL_DIR: the default /opt/campusview is used.
CV_RUN_USER=root
CV_ADMIN_USER=admin
CV_ADMIN_EMAIL=admin@example.invalid
CV_SUPERSET_WORKERS=2
CV_SYSTEMD=yes
CV_SUPERSET_DB_PASSWORD=
CV_DJANGO_DB_PASSWORD=
CV_SECRET_KEY=
CV_ADMIN_PASSWORD=
# How people reach CampusView (the "How should people reach CampusView?" question):
#   tunnel = only from this server (SSH tunnel), http = nginx on port 80, https = nginx on port 443 (default)
CV_ACCESS=https
# The address people type in the browser, without http://. Blank = this server's primary IP.
CV_SERVER_NAME=
# HTTPS only: selfsigned = the installer makes one; own = use the two PEM files below (the key without a passphrase).
CV_TLS_CERT_SOURCE=selfsigned
CV_TLS_CERT_FILE=
CV_TLS_KEY_FILE=
